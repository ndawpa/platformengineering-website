---
import { SITE } from '../config/site';
interface Item { label: string; href?: string; }
interface Props { items: Item[]; }
const { items } = Astro.props;
const schema = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: items.map((item, index) => ({ '@type': 'ListItem', position: index + 1, name: item.label, ...(item.href && { item: new URL(item.href, SITE.url).href }) })) };
---
<nav aria-label="Breadcrumb" class="text-sm text-slate-500 dark:text-slate-400">
  <ol class="flex flex-wrap items-center gap-2">{items.map((item, index) => <li class="flex items-center gap-2">{index > 0 && <span aria-hidden="true">/</span>}{item.href ? <a href={item.href} class="hover:text-sky-700 dark:hover:text-sky-400">{item.label}</a> : <span aria-current="page" class="truncate">{item.label}</span>}</li>)}</ol>
</nav>
<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
