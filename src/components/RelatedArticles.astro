---
import type { Article } from '../utils/content';
import ArticleCard from './ArticleCard.astro';
interface Props { articles: Article[]; }
const { articles } = Astro.props;
---
{articles.length > 0 && <section class="mt-16 border-t border-slate-200 pt-12 dark:border-slate-800"><p class="eyebrow">Continue estudando</p><h2 class="mt-3 text-2xl font-bold text-slate-950 dark:text-white">Artigos relacionados</h2><div class="mt-7 grid gap-5 md:grid-cols-2">{articles.map((article) => <ArticleCard article={article} />)}</div></section>}
