---
interface Props { title: string; description: string; chapters: number; href: string; status?: 'ativo' | 'planejado'; }
const { title, description, chapters, href, status = 'ativo' } = Astro.props;
---
<a href={href} class:list={['surface group block p-6 transition', status === 'ativo' ? 'hover:border-sky-400 hover:shadow-md' : 'pointer-events-none opacity-65']} aria-disabled={status === 'planejado' ? 'true' : undefined}>
  <span class:list={['rounded-full px-2.5 py-1 font-mono text-[10px] uppercase tracking-wider', status === 'ativo' ? 'bg-teal-100 text-teal-800 dark:bg-teal-950 dark:text-teal-300' : 'bg-slate-100 text-slate-500 dark:bg-slate-800']}>{status === 'ativo' ? `${chapters} ${chapters === 1 ? 'capítulo' : 'capítulos'}` : 'planejado'}</span>
  <h2 class="mt-5 text-xl font-bold text-slate-950 group-hover:text-sky-700 dark:text-white dark:group-hover:text-sky-400">{title}</h2>
  <p class="mt-3 text-sm leading-6 text-slate-600 dark:text-slate-400">{description}</p>
</a>
