---
interface Props { name: string; count?: number; description?: string; }
const { name, count, description } = Astro.props;
const slug = name.toLowerCase().replaceAll(' ', '-').replace('/', '-');
---
<a href={`/categorias/${slug}/`} class="surface group block p-5 transition hover:border-sky-300 hover:shadow-md dark:hover:border-sky-800">
  <div class="flex items-center justify-between"><span class="font-semibold text-slate-950 group-hover:text-sky-700 dark:text-white dark:group-hover:text-sky-400">{name}</span><span aria-hidden="true" class="text-slate-400 transition-transform group-hover:translate-x-1">→</span></div>
  {description && <p class="mt-2 text-sm leading-5 text-slate-500 dark:text-slate-400">{description}</p>}
  {count !== undefined && <p class="mt-3 font-mono text-xs text-slate-400">{count} {count === 1 ? 'artigo' : 'artigos'}</p>}
</a>
