---
interface Props {
  title: string;
  description: string;
  href: string;
  category: string;
  level: string;
  duration: number;
  tools: string[];
  certifications: string[];
}
const { title, description, href, category, level, duration, tools, certifications } = Astro.props;
---
<article class="surface flex h-full flex-col p-6">
  <div class="flex flex-wrap items-center gap-2 text-xs font-semibold">
    <span class="text-sky-700 dark:text-sky-400">{category}</span>
    <span aria-hidden="true" class="text-slate-300 dark:text-slate-700">·</span>
    <span class="text-slate-500">{level}</span>
    <span aria-hidden="true" class="text-slate-300 dark:text-slate-700">·</span>
    <span class="text-slate-500">{duration} min</span>
  </div>
  <h2 class="mt-4 text-xl font-bold text-slate-950 dark:text-white"><a href={href} class="hover:text-sky-700 dark:hover:text-sky-400">{title}</a></h2>
  <p class="mt-3 flex-1 text-sm leading-6 text-slate-600 dark:text-slate-400">{description}</p>
  <div class="mt-5 flex flex-wrap gap-2">{tools.map((tool) => <span class="rounded-md bg-slate-100 px-2 py-1 font-mono text-[11px] text-slate-500 dark:bg-slate-800 dark:text-slate-400">{tool}</span>)}</div>
  {certifications.length > 0 && <p class="mt-4 text-xs font-bold tracking-wide text-teal-700 dark:text-teal-400">PREPARAÇÃO {certifications.join(' · ')}</p>}
  <a href={href} class="mt-6 text-sm font-semibold text-sky-700 dark:text-sky-400">Abrir laboratório →</a>
</article>
