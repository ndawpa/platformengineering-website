---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { formatDate } from '../utils/content';
interface Props { guide: CollectionEntry<'getStarted'>; headings: import('astro').MarkdownHeading[]; }
const { guide, headings } = Astro.props;
---
<BaseLayout title={`${guide.data.tool}: instalação e primeiros passos`} description={guide.data.description}>
  <div class="container-shell py-10 lg:py-14">
    <Breadcrumb items={[{label:'Início',href:'/'},{label:'Get Started',href:'/get-started/'},{label:guide.data.tool}]} />
    <div class="mt-10 grid gap-12 lg:grid-cols-[minmax(0,1fr)_270px]">
      <article class="min-w-0">
        <header class="border-b border-slate-200 pb-9 dark:border-slate-800"><p class="eyebrow">Get Started · {guide.data.platforms.join(' · ')}</p><h1 class="mt-4 text-4xl font-black tracking-tight text-slate-950 dark:text-white sm:text-5xl">{guide.data.title}</h1><p class="mt-5 max-w-3xl text-lg leading-8 text-slate-600 dark:text-slate-300">{guide.data.description}</p><div class="mt-6 flex flex-wrap gap-4 text-sm text-slate-500"><span>Verificado em {formatDate(guide.data.verifiedAt)}</span><a href={guide.data.officialDocs} rel="noopener noreferrer" class="font-semibold text-sky-700 dark:text-sky-400">Documentação oficial ↗</a></div></header>
        {guide.data.prerequisites.length > 0 && <aside class="my-8 rounded-xl border border-sky-200 bg-sky-50/70 p-5 dark:border-sky-900 dark:bg-sky-950/20"><h2 class="font-semibold text-slate-950 dark:text-white">Antes de começar</h2><ul class="mt-3 space-y-2 text-sm text-slate-600 dark:text-slate-300">{guide.data.prerequisites.map(item => <li>→ {item}</li>)}</ul></aside>}
        <div class="prose-tech mt-10 max-w-3xl"><slot /></div>
      </article>
      <aside class="order-first lg:order-last"><div class="lg:sticky lg:top-24"><TableOfContents headings={headings} /></div></aside>
    </div>
  </div>
  <script>
    document.querySelectorAll('.prose-tech h2[id],.prose-tech h3[id]').forEach((h)=>{const a=document.createElement('a');a.href=`#${h.id}`;a.className='heading-anchor';a.textContent='#';a.setAttribute('aria-label',`Link para ${h.textContent}`);h.append(a);});
    document.querySelectorAll('.prose-tech pre').forEach((pre)=>{const w=document.createElement('div');w.className='relative';pre.parentNode?.insertBefore(w,pre);w.append(pre);const b=document.createElement('button');b.type='button';b.className='absolute right-3 top-3 rounded-md border border-slate-600 bg-slate-800 px-2.5 py-1 text-xs text-slate-200';b.textContent='Copiar';b.onclick=async()=>{await navigator.clipboard.writeText(pre.textContent??'');b.textContent='Copiado!';setTimeout(()=>b.textContent='Copiar',1600);};w.append(b);});
  </script>
</BaseLayout>
