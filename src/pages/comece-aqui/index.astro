---
import { getCollection } from 'astro:content'; import BaseLayout from '../../layouts/BaseLayout.astro'; import Breadcrumb from '../../components/Breadcrumb.astro'; import ArticleCard from '../../components/ArticleCard.astro';
const articles = await getCollection('articles', ({ data }) => !data.draft);
const fundamentals = articles.filter((article) => article.data.series === 'Fundamentos de Platform Engineering').sort((a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0));
const paths = [{ title: 'Quero entender Platform Engineering', description: 'Conceitos, limites e como uma plataforma funciona como produto.', href: '#fundamentos' }, { title: 'Preciso diagnosticar Kubernetes', description: 'Investigue falhas com evidências e uma sequência reproduzível.', href: '/artigos/kubernetes/crashloopbackoff/' }, { title: 'Quero organizar meus estudos', description: 'Percorra fundamentos, cloud, automação e experiência de desenvolvimento.', href: '/roadmap/platform-engineer/' }];
---
<BaseLayout title="Comece aqui" description="Escolha uma trilha para começar a estudar Platform Engineering, Kubernetes e infraestrutura."><div class="container-shell py-14"><Breadcrumb items={[{label:'Início',href:'/'},{label:'Comece aqui'}]} /><header class="mt-10 max-w-3xl"><p class="eyebrow">Ponto de partida</p><h1 class="mt-3 text-4xl font-black text-slate-950 dark:text-white sm:text-5xl">O que você quer construir?</h1><p class="mt-5 text-lg leading-8 text-slate-600 dark:text-slate-300">Escolha pelo problema que precisa resolver. Você não precisa estudar todo o ecossistema antes de começar.</p></header><div class="mt-10 grid gap-5 md:grid-cols-3">{paths.map((path) => <a href={path.href} class="surface group p-6 transition hover:border-sky-400"><h2 class="font-bold text-slate-950 group-hover:text-sky-700 dark:text-white">{path.title}</h2><p class="mt-3 text-sm leading-6 text-slate-600 dark:text-slate-400">{path.description}</p><span class="mt-5 block text-sky-700 dark:text-sky-400">Começar →</span></a>)}</div><section id="fundamentos" class="mt-20"><p class="eyebrow">Trilha recomendada</p><h2 class="mt-3 text-3xl font-bold text-slate-950 dark:text-white">Fundamentos de Platform Engineering</h2><div class="mt-8 grid gap-5 md:grid-cols-3">{fundamentals.map((article) => <ArticleCard article={article} />)}</div></section></div></BaseLayout>
