---
import BaseLayout from '../../layouts/BaseLayout.astro'; import Breadcrumb from '../../components/Breadcrumb.astro'; import { EDITORIAL_CLUSTERS, PRIORITY_PUBLICATIONS } from '../../config/editorial'; import { getCollection } from 'astro:content';
const articles = await getCollection('articles', ({data})=>!data.draft); const published = new Set(articles.map((article)=>article.data.title.toLowerCase()));
const status = (title:string) => published.has(title.toLowerCase()) || [...published].some((item)=>item.includes(title.toLowerCase())) ? 'Publicado' : PRIORITY_PUBLICATIONS.some((item)=>item.toLowerCase()===title.toLowerCase()) ? 'Próximo' : 'Planejado';
---
<BaseLayout title="Roadmap editorial" description="Backlog público de conteúdos e guias do Platform Engineering Brasil."><div class="container-shell py-14"><Breadcrumb items={[{label:'Início',href:'/'},{label:'Roadmap',href:'/roadmap/platform-engineer/'},{label:'Editorial'}]} /><header class="mt-10 max-w-3xl"><p class="eyebrow">Roadmap público</p><h1 class="mt-3 text-4xl font-black text-slate-950 dark:text-white sm:text-5xl">Roadmap editorial</h1><p class="mt-5 text-lg leading-8 text-slate-600 dark:text-slate-300">Os temas abaixo orientam a produção, mas só passam a publicados depois de pesquisa e revisão humana.</p></header><div class="mt-12 space-y-6">{EDITORIAL_CLUSTERS.map((cluster)=> <details class="surface group p-6" open={cluster.name==='Fundamentos de Platform Engineering'}><summary class="cursor-pointer list-none"><div class="flex items-center justify-between gap-4"><div><h2 class="text-xl font-bold text-slate-950 dark:text-white">{cluster.name}</h2><p class="mt-2 text-sm text-slate-500">{cluster.description}</p></div><span class="text-slate-400 group-open:rotate-45">+</span></div></summary><ul class="mt-6 grid gap-3 border-t border-slate-200 pt-5 dark:border-slate-800 md:grid-cols-2">{cluster.topics.map((topic)=>{const value=status(topic);return <li class="flex items-start justify-between gap-3 rounded-lg bg-slate-50 p-3 text-sm dark:bg-ink-950"><span>{topic}</span><span class:list={['shrink-0 rounded-full px-2 py-1 font-mono text-[9px] uppercase',value==='Publicado'?'bg-teal-100 text-teal-800 dark:bg-teal-950 dark:text-teal-300':value==='Próximo'?'bg-sky-100 text-sky-800 dark:bg-sky-950 dark:text-sky-300':'bg-slate-200 text-slate-500 dark:bg-slate-800']}>{value}</span></li>})}</ul></details>)}</div></div></BaseLayout>
