---
import BaseLayout from '../../layouts/BaseLayout.astro'; import Breadcrumb from '../../components/Breadcrumb.astro';
const topics = [
  ['Linux','Processos, permissões, shell e diagnóstico.'],['Networking','DNS, HTTP, TLS, roteamento e balanceamento.'],['Git','Histórico, colaboração e automação.'],['Containers','Isolamento, imagens, registries e runtime.'],['Docker','Builds reproduzíveis e segurança de imagens.'],['Kubernetes','Workloads, rede, storage, RBAC e operação.'],['Cloud','Identidade, compute, rede, dados e custos.'],['Infrastructure as Code','Estado, módulos, revisão e automação.'],['CI/CD','Feedback rápido, artefatos e entrega segura.'],['GitOps','Reconciliação e operação declarativa.'],['Observability','Métricas, logs, traces, SLOs e alertas.'],['Security','Threat modeling, supply chain e guardrails.'],['Platform Engineering','Produto interno, golden paths e experiência.']
];
---
<BaseLayout title="Roadmap para Platform Engineer" description="Trilha visual de aprendizado para se tornar Platform Engineer, dos fundamentos à plataforma como produto."><div class="container-shell py-14"><Breadcrumb items={[{ label: 'Início', href: '/' }, { label: 'Roadmap' }, { label: 'Platform Engineer' }]} /><header class="mx-auto mt-10 max-w-3xl text-center"><p class="eyebrow">Trilha de aprendizado</p><h1 class="mt-3 text-4xl font-black text-slate-950 dark:text-white sm:text-5xl">Roadmap para Platform Engineer</h1><p class="mt-5 text-lg leading-8 text-slate-600 dark:text-slate-300">Uma sequência orientativa — não uma lista de pré-requisitos. Construa projetos entre os blocos e aprofunde conforme o contexto.</p></header><ol class="relative mx-auto mt-14 max-w-3xl before:absolute before:bottom-8 before:left-7 before:top-8 before:w-px before:bg-gradient-to-b before:from-sky-400 before:to-teal-400 sm:before:left-1/2">{topics.map(([title, description], index) => <li class:list={['relative mb-7 flex items-center gap-5 sm:w-1/2', index % 2 === 0 ? 'sm:pr-10 sm:text-right' : 'sm:ml-auto sm:flex-row-reverse sm:pl-10']}><span class:list={['relative z-10 grid size-14 shrink-0 place-items-center rounded-2xl border-4 border-slate-50 bg-gradient-to-br from-sky-500 to-teal-400 font-mono text-sm font-bold text-white shadow-md dark:border-ink-950', index % 2 === 0 ? 'sm:absolute sm:-right-7' : 'sm:absolute sm:-left-7']}>{String(index + 1).padStart(2, '0')}</span><div class="surface flex-1 p-5"><h2 class="font-bold text-slate-950 dark:text-white">{title}</h2><p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-400">{description}</p></div></li>)}</ol><div class="mx-auto mt-12 max-w-3xl rounded-2xl bg-slate-950 p-8 text-white dark:bg-slate-800"><h2 class="text-xl font-bold">Aprenda construindo</h2><p class="mt-3 leading-7 text-slate-300">Use a trilha como mapa, não checklist. Crie uma aplicação, automatize sua infraestrutura, opere-a e transforme os aprendizados em um caminho reutilizável.</p><a href="/artigos/platform-engineering/roadmap-platform-engineer/" class="mt-5 inline-block font-semibold text-sky-300 hover:underline">Ler o guia de carreira →</a></div></div></BaseLayout>
