---
import { getCollection } from 'astro:content'; import BaseLayout from '../../layouts/BaseLayout.astro'; import Breadcrumb from '../../components/Breadcrumb.astro'; import { articlePath, readingTime } from '../../utils/content';
const chapters = (await getCollection('articles', ({data}) => !data.draft && data.series === 'Fundamentos de Platform Engineering')).sort((a,b)=>(a.data.seriesOrder??0)-(b.data.seriesOrder??0));
---
<BaseLayout title="Guia: Fundamentos de Platform Engineering" description="Uma sequência curta para entender plataformas internas, disciplinas relacionadas e a trilha de Platform Engineer."><div class="container-shell py-14"><Breadcrumb items={[{label:'Início',href:'/'},{label:'Guias',href:'/guias/'},{label:'Fundamentos de Platform Engineering'}]} /><header class="mt-10 max-w-3xl"><p class="eyebrow">Guia essencial</p><h1 class="mt-3 text-4xl font-black text-slate-950 dark:text-white sm:text-5xl">Fundamentos de Platform Engineering</h1><p class="mt-5 text-lg leading-8 text-slate-600 dark:text-slate-300">Entenda o problema, as fronteiras com DevOps e SRE e como desenvolver as competências necessárias.</p><div class="mt-6 flex gap-4 text-sm text-slate-500"><span>{chapters.length} capítulos</span><span>·</span><span>{chapters.reduce((total,chapter)=>total+readingTime(chapter.body),0)} min</span></div></header><div class="mt-10 grid gap-10 lg:grid-cols-[1fr_280px]"><ol class="space-y-4">{chapters.map((chapter,index) => <li class="surface flex gap-4 p-5"><input type="checkbox" data-progress={chapter.id} class="mt-1 size-5 accent-teal-500" aria-label={`Marcar capítulo ${index+1} como concluído`} /><div><p class="font-mono text-xs text-sky-700 dark:text-sky-400">CAPÍTULO {index+1}</p><a href={articlePath(chapter)} class="mt-2 block text-lg font-bold text-slate-950 hover:text-sky-700 dark:text-white dark:hover:text-sky-400">{chapter.data.title}</a><p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-400">{chapter.data.description}</p></div></li>)}</ol><aside class="surface h-fit p-5 lg:sticky lg:top-24"><p class="font-semibold text-slate-950 dark:text-white">Seu progresso</p><div class="mt-4 h-2 overflow-hidden rounded-full bg-slate-200 dark:bg-slate-700"><div id="progress-bar" class="h-full w-0 bg-gradient-to-r from-sky-500 to-teal-400 transition-all"></div></div><p id="progress-label" class="mt-3 text-sm text-slate-500" aria-live="polite">0 de {chapters.length} concluídos</p><p class="mt-4 text-xs leading-5 text-slate-400">Salvo apenas neste navegador.</p></aside></div></div><script>
const key='pe-guide-fundamentos';const boxes=[...document.querySelectorAll<HTMLInputElement>('[data-progress]')];let saved:string[]=[];try{saved=JSON.parse(localStorage.getItem(key)??'[]');}catch{saved=[];}const update=()=>{const done=boxes.filter(box=>box.checked).map(box=>box.dataset.progress!);localStorage.setItem(key,JSON.stringify(done));const percent=boxes.length?done.length/boxes.length*100:0;const bar=document.querySelector<HTMLElement>('#progress-bar');if(bar)bar.style.width=`${percent}%`;const label=document.querySelector('#progress-label');if(label)label.textContent=`${done.length} de ${boxes.length} concluídos`;};boxes.forEach(box=>{box.checked=saved.includes(box.dataset.progress!);box.addEventListener('change',update);});update();
</script></BaseLayout>
