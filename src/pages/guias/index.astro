---
import { getCollection } from 'astro:content'; import BaseLayout from '../../layouts/BaseLayout.astro'; import Breadcrumb from '../../components/Breadcrumb.astro'; import GuideCard from '../../components/GuideCard.astro';
const articles = await getCollection('articles', ({data}) => !data.draft);
const count = (series: string) => articles.filter((article) => article.data.series === series).length;
const active = [
  ['Fundamentos de Platform Engineering','Conceitos, produto, golden paths e métricas de uma plataforma interna.','Fundamentos de Platform Engineering','/guias/fundamentos-platform-engineering/'],
  ['Kubernetes Troubleshooting','Diagnóstico baseado em evidências para workloads Kubernetes.','Kubernetes Troubleshooting','/guias/kubernetes-troubleshooting/'],
  ['Terraform em produção','Organização, estado e operação segura de infraestrutura como código.','Terraform em produção','/guias/terraform-em-producao/'],
  ['GitOps com Argo CD','Reconciliação, repositórios e operação declarativa no Kubernetes.','GitOps com Argo CD','/guias/gitops-com-argo-cd/'],
  ['Observability e SRE','Objetivos de confiabilidade e sinais orientados ao usuário.','Observability e SRE','/guias/observability-e-sre/'],
  ['CI/CD e software supply chain','Entrega segura, artefatos verificáveis e identidade de pipelines.','CI/CD e software supply chain','/guias/cicd-supply-chain/'],
];
---
<BaseLayout title="Guias" description="Trilhas de estudo e guias técnicos estruturados sobre engenharia de plataforma."><div class="container-shell py-14"><Breadcrumb items={[{label:'Início',href:'/'},{label:'Guias'}]} /><header class="mt-10 max-w-3xl"><p class="eyebrow">Aprendizado estruturado</p><h1 class="mt-3 text-4xl font-black text-slate-950 dark:text-white sm:text-5xl">Guias</h1><p class="mt-5 text-lg leading-8 text-slate-600 dark:text-slate-300">Sequências curadas que conectam conceitos, prática e decisões de arquitetura.</p></header><div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">{active.map(([title,description,series,href]) => <GuideCard title={title} description={description} chapters={count(series)} href={href} />)}</div><section class="mt-16"><div class="flex items-end justify-between gap-4"><div><p class="eyebrow">Transparência</p><h2 class="mt-3 text-2xl font-bold text-slate-950 dark:text-white">O que vem depois</h2></div><a href="/roadmap/editorial/" class="text-sm font-semibold text-sky-700 dark:text-sky-400">Ver roadmap editorial →</a></div><div class="mt-6 grid gap-4 sm:grid-cols-2">{[['Cloud para plataformas','Fundações de identidade, rede e custos para AWS e Azure.'],['Developer Experience','Catálogo, self-service, scorecards e pesquisa com usuários internos.']].map(([title,description]) => <GuideCard title={title} description={description} chapters={0} href="#" status="planejado" />)}</div></section></div></BaseLayout>
