---
import { getCollection } from 'astro:content'; import BaseLayout from '../../layouts/BaseLayout.astro'; import Breadcrumb from '../../components/Breadcrumb.astro'; import ArticleCard from '../../components/ArticleCard.astro'; import { AUTHORS } from '../../config/site'; import { byNewest } from '../../utils/content';
const author = AUTHORS['platform-engineering-brasil']; const articles = (await getCollection('articles', ({data}) => !data.draft && data.author === author.name)).sort(byNewest);
---
<BaseLayout title={author.name} description={author.bio}><div class="container-shell py-14"><Breadcrumb items={[{label:'Início',href:'/'},{label:'Autores'},{label:author.name}]} /><header class="surface mt-10 max-w-4xl p-8 sm:p-10"><p class="eyebrow">{author.role}</p><h1 class="mt-3 text-4xl font-black text-slate-950 dark:text-white">{author.name}</h1><p class="mt-5 max-w-2xl text-lg leading-8 text-slate-600 dark:text-slate-300">{author.bio}</p><div class="mt-6 flex flex-wrap gap-2">{author.expertise.map((item) => <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold dark:bg-slate-800">{item}</span>)}</div></header><section class="mt-14"><h2 class="text-2xl font-bold text-slate-950 dark:text-white">Conteúdos publicados</h2><div class="mt-7 grid gap-5 md:grid-cols-2 lg:grid-cols-3">{articles.map((article) => <ArticleCard article={article} />)}</div></section></div></BaseLayout>
