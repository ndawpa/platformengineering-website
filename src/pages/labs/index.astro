---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import LabCard from '../../components/LabCard.astro';
const labs = (await getCollection('labs', ({ data }) => !data.draft)).sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || a.data.title.localeCompare(b.data.title, 'pt-BR'));
const technologies = [...new Set(labs.map((lab) => lab.data.category))].sort((a, b) => a.localeCompare(b, 'pt-BR'));
const levels = ['Iniciante', 'Intermediário', 'Avançado'];
const formats = ['Guiado', 'Desafio', 'Incidente'];
const certifications = [...new Set(labs.flatMap((lab) => lab.data.certifications))].sort();
const fieldClass = 'mt-2 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm normal-case tracking-normal text-slate-800 dark:border-slate-700 dark:bg-ink-900 dark:text-slate-100';
---
<BaseLayout title="Laboratórios práticos" description="Laboratórios reproduzíveis de Platform Engineering, Kubernetes, GitOps e infraestrutura para executar localmente.">
  <div class="container-shell py-14">
    <Breadcrumb items={[{ label: 'Início', href: '/' }, { label: 'Labs' }]} />
    <header class="mt-10 max-w-3xl"><p class="eyebrow">Aprender fazendo</p><h1 class="mt-3 text-4xl font-black text-slate-950 dark:text-white sm:text-5xl">Laboratórios práticos</h1><p class="mt-5 text-lg leading-8 text-slate-600 dark:text-slate-300">Ambientes reproduzíveis para praticar no seu computador. Encontre um exercício por tecnologia, nível, formato ou objetivo de certificação.</p></header>

    <form id="lab-filters" class="surface mt-9 p-4" aria-label="Filtrar laboratórios">
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <label class="text-xs font-semibold uppercase tracking-wide text-slate-500">Buscar<input id="lab-query" name="busca" type="search" class={fieldClass} placeholder="Título, objetivo ou ferramenta" /></label>
        <label class="text-xs font-semibold uppercase tracking-wide text-slate-500">Tecnologia<select id="lab-technology" name="tecnologia" class={fieldClass}><option value="">Todas</option>{technologies.map((item) => <option value={item}>{item}</option>)}</select></label>
        <label class="text-xs font-semibold uppercase tracking-wide text-slate-500">Nível<select id="lab-level" name="nivel" class={fieldClass}><option value="">Todos</option>{levels.map((item) => <option value={item}>{item}</option>)}</select></label>
        <label class="text-xs font-semibold uppercase tracking-wide text-slate-500">Formato<select id="lab-format" name="formato" class={fieldClass}><option value="">Todos</option>{formats.map((item) => <option value={item}>{item}</option>)}</select></label>
        <label class="text-xs font-semibold uppercase tracking-wide text-slate-500">Certificação<select id="lab-certification" name="certificacao" class={fieldClass}><option value="">Todas</option>{certifications.map((item) => <option value={item}>{item}</option>)}</select></label>
        <label class="text-xs font-semibold uppercase tracking-wide text-slate-500">Duração<select id="lab-duration" name="duracao" class={fieldClass}><option value="">Qualquer duração</option><option value="30">Até 30 min</option><option value="60">31–60 min</option><option value="61">Mais de 60 min</option></select></label>
      </div>
      <div class="mt-4 flex flex-wrap items-end justify-between gap-4 border-t border-slate-200 pt-4 dark:border-slate-800">
        <label class="text-xs font-semibold uppercase tracking-wide text-slate-500">Ordenar<select id="lab-sort" name="ordem" class={`${fieldClass} min-w-52`}><option value="recommended">Trilha recomendada</option><option value="duration">Menor duração</option><option value="difficulty">Maior dificuldade</option><option value="recent">Atualizados recentemente</option></select></label>
        <button id="lab-clear" type="reset" class="rounded-lg border border-slate-300 px-4 py-2.5 text-sm font-semibold text-slate-600 hover:border-sky-500 hover:text-sky-700 dark:border-slate-700 dark:text-slate-300">Limpar filtros</button>
      </div>
    </form>

    <p id="lab-count" class="mt-5 text-sm text-slate-500" aria-live="polite">{labs.length} laboratórios</p>
    <section id="lab-grid" class="mt-5 grid gap-5 md:grid-cols-2 lg:grid-cols-3" aria-label="Laboratórios disponíveis">{labs.map((lab, index) => <div data-lab data-order={index} data-technology={lab.data.category} data-level={lab.data.level} data-format={lab.data.format} data-certifications={lab.data.certifications.join('|')} data-duration={lab.data.duration} data-updated={lab.data.updatedAt.toISOString()} data-search={`${lab.data.title} ${lab.data.description} ${lab.data.objectives.join(' ')} ${lab.data.tools.join(' ')}`}><LabCard title={lab.data.title} description={lab.data.description} href={`/labs/${lab.id}/`} category={lab.data.category} level={lab.data.level} duration={lab.data.duration} tools={lab.data.tools} certifications={lab.data.certifications} format={lab.data.format} /></div>)}</section>
    <div id="lab-empty" class="surface mt-5 hidden p-8 text-center"><p class="font-semibold text-slate-950 dark:text-white">Nenhum laboratório encontrado</p><p class="mt-2 text-sm text-slate-600 dark:text-slate-400">Remova um filtro ou tente outro termo.</p></div>
    <aside class="mt-14 rounded-2xl border border-slate-200 bg-slate-50 p-6 dark:border-slate-800 dark:bg-slate-900/50"><h2 class="text-lg font-bold text-slate-950 dark:text-white">Ambientes interativos estão no horizonte</h2><p class="mt-2 max-w-3xl text-sm leading-6 text-slate-600 dark:text-slate-400">Os labs usam uma estrutura independente do executor. Por enquanto, toda a prática roda localmente sem cadastro e sem enviar dados.</p></aside>
  </div>
  <script>
    const form=document.querySelector<HTMLFormElement>('#lab-filters')!; const grid=document.querySelector<HTMLElement>('#lab-grid')!; const cards=[...document.querySelectorAll<HTMLElement>('[data-lab]')]; const count=document.querySelector('#lab-count')!; const empty=document.querySelector('#lab-empty')!;
    const fields={query:document.querySelector<HTMLInputElement>('#lab-query')!,technology:document.querySelector<HTMLSelectElement>('#lab-technology')!,level:document.querySelector<HTMLSelectElement>('#lab-level')!,format:document.querySelector<HTMLSelectElement>('#lab-format')!,certification:document.querySelector<HTMLSelectElement>('#lab-certification')!,duration:document.querySelector<HTMLSelectElement>('#lab-duration')!,sort:document.querySelector<HTMLSelectElement>('#lab-sort')!};
    const normalize=(value:string)=>value.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase(); const difficulty:Record<string,number>={Iniciante:1,'Intermediário':2,'Avançado':3};
    const apply=()=>{const term=normalize(fields.query.value);let visible=0;cards.forEach(card=>{const minutes=Number(card.dataset.duration);const duration=fields.duration.value;const durationMatch=!duration||(duration==='30'&&minutes<=30)||(duration==='60'&&minutes>30&&minutes<=60)||(duration==='61'&&minutes>60);const show=(!term||normalize(card.dataset.search??'').includes(term))&&(!fields.technology.value||card.dataset.technology===fields.technology.value)&&(!fields.level.value||card.dataset.level===fields.level.value)&&(!fields.format.value||card.dataset.format===fields.format.value)&&(!fields.certification.value||(card.dataset.certifications??'').split('|').includes(fields.certification.value))&&durationMatch;card.classList.toggle('hidden',!show);if(show)visible++;});const sorted=[...cards].sort((a,b)=>fields.sort.value==='duration'?Number(a.dataset.duration)-Number(b.dataset.duration):fields.sort.value==='difficulty'?(difficulty[b.dataset.level??'']??0)-(difficulty[a.dataset.level??'']??0):fields.sort.value==='recent'?Date.parse(b.dataset.updated??'')-Date.parse(a.dataset.updated??''):Number(a.dataset.order)-Number(b.dataset.order));sorted.forEach(card=>grid.append(card));count.textContent=`${visible} ${visible===1?'laboratório':'laboratórios'}`;empty.classList.toggle('hidden',visible>0);const params=new URLSearchParams();Object.entries({busca:fields.query.value,tecnologia:fields.technology.value,nivel:fields.level.value,formato:fields.format.value,certificacao:fields.certification.value,duracao:fields.duration.value,ordem:fields.sort.value==='recommended'?'':fields.sort.value}).forEach(([key,value])=>value&&params.set(key,value));history.replaceState(null,'',`${location.pathname}${params.size?`?${params}`:''}`);};
    const params=new URLSearchParams(location.search);fields.query.value=params.get('busca')??'';fields.technology.value=params.get('tecnologia')??'';fields.level.value=params.get('nivel')??'';fields.format.value=params.get('formato')??'';fields.certification.value=params.get('certificacao')??'';fields.duration.value=params.get('duracao')??'';fields.sort.value=params.get('ordem')??'recommended';form.addEventListener('input',apply);form.addEventListener('reset',()=>requestAnimationFrame(apply));apply();
  </script>
</BaseLayout>
