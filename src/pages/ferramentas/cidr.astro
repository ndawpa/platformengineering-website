---
import ToolLayout from '../../layouts/ToolLayout.astro';
---
<ToolLayout title="CIDR Calculator" description="Calcule rede, broadcast e intervalo utilizável de blocos IPv4."><label for="cidr" class="text-sm font-semibold">IPv4 com prefixo CIDR</label><div class="mt-2 flex flex-col gap-3 sm:flex-row"><input id="cidr" value="10.0.0.0/24" class="min-w-0 flex-1 rounded-lg border border-slate-300 bg-transparent px-4 py-3 font-mono dark:border-slate-700" /><button id="calculate" class="rounded-lg bg-sky-600 px-5 py-3 text-sm font-semibold text-white">Calcular</button></div><dl id="cidr-result" class="mt-7 grid gap-4 sm:grid-cols-2" aria-live="polite"></dl><script>
const input=document.querySelector<HTMLInputElement>('#cidr')!;const output=document.querySelector('#cidr-result')!;const toIp=(n:number)=>[24,16,8,0].map(s=>(n>>>s)&255).join('.');const run=()=>{const [ip,prefixRaw]=input.value.trim().split('/');const octets=ip?.split('.').map(Number);const prefix=Number(prefixRaw);if(!octets||octets.length!==4||octets.some(n=>!Number.isInteger(n)||n<0||n>255)||!Number.isInteger(prefix)||prefix<0||prefix>32){output.innerHTML='<p class="text-red-600">CIDR IPv4 inválido.</p>';return;}const value=octets.reduce((acc,n)=>(acc*256+n)>>>0,0);const mask=prefix===0?0:(0xffffffff<<(32-prefix))>>>0;const network=(value&mask)>>>0;const broadcast=(network|(~mask>>>0))>>>0;const total=2**(32-prefix);const rows=[['Rede',toIp(network)],['Broadcast',toIp(broadcast)],['Máscara',toIp(mask)],['Endereços',String(total)],['Primeiro utilizável',toIp(prefix>=31?network:(network+1)>>>0)],['Último utilizável',toIp(prefix>=31?broadcast:(broadcast-1)>>>0)]];output.replaceChildren(...rows.map(([k,v])=>{const d=document.createElement('div');d.className='rounded-lg bg-slate-100 p-4 dark:bg-slate-800';d.innerHTML=`<dt class="text-xs uppercase text-slate-500">${k}</dt><dd class="mt-1 font-mono font-semibold">${v}</dd>`;return d;}));};document.querySelector('#calculate')?.addEventListener('click',run);run();
</script></ToolLayout>
