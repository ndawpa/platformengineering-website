---
import ToolLayout from '../../layouts/ToolLayout.astro';
---
<ToolLayout title="JWT Decoder" description="Inspecione header e payload de um JWT localmente. A ferramenta não valida a assinatura."><label for="jwt" class="text-sm font-semibold">Token JWT</label><textarea id="jwt" rows="5" class="mt-2 w-full rounded-lg border border-slate-300 bg-transparent p-4 font-mono text-sm dark:border-slate-700" placeholder="eyJ..."></textarea><button id="decode-jwt" class="mt-4 rounded-lg bg-sky-600 px-5 py-3 text-sm font-semibold text-white">Decodificar</button><p class="mt-4 text-sm text-amber-700 dark:text-amber-300">Decodificar não comprova autenticidade. Valide assinatura, issuer e audience no sistema responsável.</p><div class="mt-7 grid gap-5 md:grid-cols-2"><div><h2 class="font-semibold">Header</h2><pre id="jwt-header" class="mt-2 min-h-32 overflow-auto rounded-lg bg-slate-950 p-4 text-xs text-slate-200"></pre></div><div><h2 class="font-semibold">Payload</h2><pre id="jwt-payload" class="mt-2 min-h-32 overflow-auto rounded-lg bg-slate-950 p-4 text-xs text-slate-200"></pre></div></div><p id="jwt-status" class="mt-4 text-sm text-red-600" aria-live="polite"></p><script>
const decode=(part:string)=>{const normalized=part.replace(/-/g,'+').replace(/_/g,'/').padEnd(Math.ceil(part.length/4)*4,'=');const bytes=Uint8Array.from(atob(normalized),c=>c.charCodeAt(0));return JSON.parse(new TextDecoder().decode(bytes));};document.querySelector('#decode-jwt')?.addEventListener('click',()=>{const value=document.querySelector<HTMLTextAreaElement>('#jwt')!.value.trim();const status=document.querySelector('#jwt-status')!;try{const parts=value.split('.');if(parts.length!==3)throw new Error();document.querySelector('#jwt-header')!.textContent=JSON.stringify(decode(parts[0]),null,2);document.querySelector('#jwt-payload')!.textContent=JSON.stringify(decode(parts[1]),null,2);status.textContent='';}catch{status.textContent='JWT inválido ou conteúdo não codificado como JSON.';}});
</script></ToolLayout>
