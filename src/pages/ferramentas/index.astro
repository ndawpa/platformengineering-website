---
import BaseLayout from '../../layouts/BaseLayout.astro'; import Breadcrumb from '../../components/Breadcrumb.astro'; import ToolCard from '../../components/ToolCard.astro';
const tools = [
  ['Base64 Encoder / Decoder','Converta texto Unicode de e para Base64.','/ferramentas/base64/'],
  ['Cron Expression Helper','Valide e entenda expressões cron de cinco campos.','/ferramentas/cron/'],
  ['CIDR Calculator','Calcule rede, broadcast e intervalos IPv4.','/ferramentas/cidr/'],
  ['YAML Validator','Valide sintaxe YAML e inspecione a estrutura.','/ferramentas/yaml-validator/'],
  ['JWT Decoder','Inspecione header e payload sem enviar o token.','/ferramentas/jwt/'],
  ['Kubernetes Resource Calculator','Transforme p95 observado em configuração inicial.','/ferramentas/kubernetes-resources/'],
  ['Dockerfile Analyzer','Revise padrões básicos de segurança e builds.','/ferramentas/dockerfile-analyzer/'],
];
---
<BaseLayout title="Ferramentas" description="Ferramentas gratuitas para tarefas comuns de cloud, Kubernetes, infraestrutura e desenvolvimento."><div class="container-shell py-14"><Breadcrumb items={[{ label: 'Início', href: '/' }, { label: 'Ferramentas' }]} /><header class="mt-10 max-w-3xl"><p class="eyebrow">Developer tools</p><h1 class="mt-3 text-4xl font-black text-slate-950 dark:text-white sm:text-5xl">Ferramentas</h1><p class="mt-5 text-lg leading-8 text-slate-600 dark:text-slate-300">Utilitários rápidos, gratuitos e com processamento local. Nenhum dado inserido é enviado ao portal.</p></header><section class="mt-12"><h2 class="text-xl font-bold text-slate-950 dark:text-white">Disponíveis agora</h2><div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{tools.map(([title, description, href]) => <ToolCard title={title} description={description} href={href} status="local" />)}</div></section></div></BaseLayout>
