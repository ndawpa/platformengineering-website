---
import ToolLayout from '../../layouts/ToolLayout.astro';
---
<ToolLayout title="Dockerfile Analyzer" description="Faça uma revisão rápida de padrões comuns de segurança e reprodutibilidade em Dockerfiles."><label for="dockerfile" class="text-sm font-semibold">Dockerfile</label><textarea id="dockerfile" rows="12" spellcheck="false" class="mt-2 w-full rounded-lg border border-slate-300 bg-transparent p-4 font-mono text-sm dark:border-slate-700">FROM node:22\nWORKDIR /app\nCOPY . .\nRUN npm install\nCMD ["npm", "start"]</textarea><button id="analyze-docker" class="mt-4 rounded-lg bg-sky-600 px-5 py-3 text-sm font-semibold text-white">Analisar</button><ul id="docker-results" class="mt-6 space-y-3 text-sm" aria-live="polite"></ul><script>
const run=()=>{const value=document.querySelector<HTMLTextAreaElement>('#dockerfile')!.value;const checks: Array<[RegExp,string,string?]>=[[/^FROM\s+[^\n]+:latest/im,'Evite tags latest; fixe uma versão de imagem.'],[/^USER\s+/im,'','Usuário não-root configurado.'],[/npm install(?!\s+--)/i,'Prefira npm ci para builds reproduzíveis.'],[/curl.+\|\s*(sh|bash)/i,'Evite executar downloads diretamente no shell.'],[/^HEALTHCHECK\s+/im,'','Healthcheck declarado.'],[/^COPY\s+\.\s+\./im,'COPY . . depende de um .dockerignore bem definido.']];const findings:string[]=[];checks.forEach(([pattern,warning,success])=>{const found=pattern.test(value);if(warning&&found)findings.push(`⚠ ${warning}`);if(success)findings.push(found?`✓ ${success}`:`⚠ ${success.replace(' configurado',' não configurado').replace(' declarado',' não declarado')}`);});const list=document.querySelector('#docker-results')!;list.replaceChildren(...findings.map(text=>{const li=document.createElement('li');li.className='rounded-lg bg-slate-100 p-4 dark:bg-slate-800';li.textContent=text;return li;}));};document.querySelector('#analyze-docker')?.addEventListener('click',run);run();
</script></ToolLayout>
