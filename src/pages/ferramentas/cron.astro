---
import ToolLayout from '../../layouts/ToolLayout.astro';
---
<ToolLayout title="Cron Expression Helper" description="Valide e entenda expressões cron de cinco campos sem depender de um serviço externo."><label for="cron" class="text-sm font-semibold">Expressão cron</label><div class="mt-2 flex flex-col gap-3 sm:flex-row"><input id="cron" value="*/15 9-18 * * 1-5" class="min-w-0 flex-1 rounded-lg border border-slate-300 bg-transparent px-4 py-3 font-mono dark:border-slate-700" /><button id="explain" class="rounded-lg bg-sky-600 px-5 py-3 text-sm font-semibold text-white">Analisar</button></div><div class="mt-5 flex flex-wrap gap-2">{['0 9 * * 1-5','*/5 * * * *','0 0 1 * *'].map((value) => <button type="button" data-cron={value} class="rounded-md bg-slate-100 px-3 py-2 font-mono text-xs dark:bg-slate-800">{value}</button>)}</div><div id="cron-result" class="mt-7 rounded-xl bg-slate-100 p-5 text-sm leading-7 dark:bg-slate-800" aria-live="polite"></div><script>
const input=document.querySelector<HTMLInputElement>('#cron')!;const result=document.querySelector('#cron-result')!;const names=['minuto','hora','dia do mês','mês','dia da semana'];const describe=(v:string,n:string)=>v==='*'?`qualquer ${n}`:v.startsWith('*/')?`a cada ${v.slice(2)} unidades em ${n}`:v.includes('-')?`${n} entre ${v.replace('-', ' e ')}`:v.includes(',')?`${n} em ${v.replaceAll(',', ', ')}`:`${n} = ${v}`;const run=()=>{const fields=input.value.trim().split(/\s+/);if(fields.length!==5||fields.some(v=>!/^[\d*/?,-]+$/.test(v))){result.textContent='Expressão inválida. Use cinco campos: minuto, hora, dia do mês, mês e dia da semana.';return;}result.replaceChildren(...fields.map((v,i)=>{const p=document.createElement('p');p.textContent=`${i+1}. ${describe(v,names[i])}`;return p;}));};document.querySelector('#explain')?.addEventListener('click',run);document.querySelectorAll<HTMLElement>('[data-cron]').forEach(b=>b.addEventListener('click',()=>{input.value=b.dataset.cron??'';run();}));run();
</script></ToolLayout>
