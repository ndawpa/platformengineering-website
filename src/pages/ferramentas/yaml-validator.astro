---
import ToolLayout from '../../layouts/ToolLayout.astro';
---
<ToolLayout title="YAML Validator" description="Valide sintaxe YAML e visualize o documento normalizado diretamente no navegador."><label for="yaml-input" class="text-sm font-semibold">Documento YAML</label><textarea id="yaml-input" rows="12" spellcheck="false" class="mt-2 w-full rounded-lg border border-slate-300 bg-transparent p-4 font-mono text-sm dark:border-slate-700">apiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: example</textarea><button id="validate-yaml" class="mt-4 rounded-lg bg-sky-600 px-5 py-3 text-sm font-semibold text-white">Validar</button><p id="yaml-status" class="mt-4 text-sm" aria-live="polite"></p><pre id="yaml-output" class="mt-4 overflow-auto rounded-lg bg-slate-950 p-5 text-sm text-slate-200"></pre><script>
import { parseDocument } from 'yaml';const run=()=>{const source=document.querySelector<HTMLTextAreaElement>('#yaml-input')!.value;const status=document.querySelector<HTMLElement>('#yaml-status')!;const output=document.querySelector('#yaml-output')!;const doc=parseDocument(source);if(doc.errors.length){status.className='mt-4 text-sm text-red-600';status.textContent=doc.errors.map(e=>e.message).join('\n');output.textContent='';}else{status.className='mt-4 text-sm text-teal-700 dark:text-teal-400';status.textContent='YAML válido.';output.textContent=JSON.stringify(doc.toJS(),null,2);}};document.querySelector('#validate-yaml')?.addEventListener('click',run);run();
</script></ToolLayout>
