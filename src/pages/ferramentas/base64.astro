---
import BaseLayout from '../../layouts/BaseLayout.astro'; import Breadcrumb from '../../components/Breadcrumb.astro';
---
<BaseLayout title="Base64 Encoder / Decoder" description="Codifique e decodifique Base64 gratuitamente, com suporte a Unicode e processamento inteiramente local."><div class="container-shell py-14"><Breadcrumb items={[{ label: 'Início', href: '/' }, { label: 'Ferramentas', href: '/ferramentas/' }, { label: 'Base64 Encoder / Decoder' }]} /><header class="mt-10 max-w-3xl"><p class="eyebrow">Ferramenta local</p><h1 class="mt-3 text-4xl font-black text-slate-950 dark:text-white sm:text-5xl">Base64 Encoder / Decoder</h1><p class="mt-5 text-lg leading-8 text-slate-600 dark:text-slate-300">Codifique ou decodifique texto com suporte a Unicode. O conteúdo não sai do seu navegador.</p></header><div class="surface mt-10 max-w-4xl p-5 sm:p-8"><div class="flex flex-wrap gap-2" role="group" aria-label="Operação"><button id="encode" type="button" class="operation rounded-lg bg-slate-950 px-4 py-2.5 text-sm font-semibold text-white dark:bg-white dark:text-slate-950" aria-pressed="true">Codificar</button><button id="decode" type="button" class="operation rounded-lg px-4 py-2.5 text-sm font-semibold text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800" aria-pressed="false">Decodificar</button></div><label for="input" class="mt-7 block text-sm font-semibold text-slate-800 dark:text-slate-200">Entrada</label><textarea id="input" rows="7" spellcheck="false" class="mt-2 w-full resize-y rounded-xl border border-slate-300 bg-slate-50 p-4 font-mono text-sm focus:border-sky-500 dark:border-slate-700 dark:bg-ink-950" placeholder="Digite ou cole o conteúdo"></textarea><div class="mt-5 flex flex-wrap items-center gap-3"><button id="convert" type="button" class="rounded-lg bg-sky-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-sky-700">Codificar Base64</button><button id="clear" type="button" class="rounded-lg border border-slate-300 px-4 py-2.5 text-sm font-semibold hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800">Limpar</button><span id="status" class="text-sm text-slate-500" role="status" aria-live="polite"></span></div><div class="mt-7 flex items-center justify-between"><label for="output" class="text-sm font-semibold text-slate-800 dark:text-slate-200">Resultado</label><button id="copy" type="button" class="text-sm font-semibold text-sky-700 hover:underline dark:text-sky-400">Copiar resultado</button></div><textarea id="output" rows="7" readonly class="mt-2 w-full resize-y rounded-xl border border-slate-300 bg-slate-100 p-4 font-mono text-sm dark:border-slate-700 dark:bg-slate-900" placeholder="O resultado aparecerá aqui"></textarea></div><section class="mt-12 max-w-3xl"><h2 class="text-2xl font-bold text-slate-950 dark:text-white">Sobre Base64</h2><p class="mt-4 leading-7 text-slate-600 dark:text-slate-300">Base64 representa dados binários como texto. É uma codificação, não criptografia: qualquer pessoa com o valor pode decodificá-lo. Não use Base64 para proteger informações sensíveis.</p></section></div>
<script>
  const input = document.querySelector<HTMLTextAreaElement>('#input')!; const output = document.querySelector<HTMLTextAreaElement>('#output')!; const convert = document.querySelector<HTMLButtonElement>('#convert')!; const status = document.querySelector('#status')!; const encodeButton = document.querySelector<HTMLButtonElement>('#encode')!; const decodeButton = document.querySelector<HTMLButtonElement>('#decode')!; let mode: 'encode' | 'decode' = 'encode';
  const toBase64 = (value: string) => { const bytes = new TextEncoder().encode(value); let binary = ''; bytes.forEach((byte) => binary += String.fromCharCode(byte)); return btoa(binary); };
  const fromBase64 = (value: string) => { const normalized = value.replace(/\s/g, ''); const binary = atob(normalized); return new TextDecoder('utf-8', { fatal: true }).decode(Uint8Array.from(binary, (char) => char.charCodeAt(0))); };
  const setMode = (next: 'encode' | 'decode') => { mode = next; [encodeButton, decodeButton].forEach((button) => { const active = button.id === next; button.setAttribute('aria-pressed', String(active)); button.className = active ? 'operation rounded-lg bg-slate-950 px-4 py-2.5 text-sm font-semibold text-white dark:bg-white dark:text-slate-950' : 'operation rounded-lg px-4 py-2.5 text-sm font-semibold text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800'; }); convert.textContent = next === 'encode' ? 'Codificar Base64' : 'Decodificar Base64'; output.value = ''; status.textContent = ''; };
  encodeButton.addEventListener('click', () => setMode('encode')); decodeButton.addEventListener('click', () => setMode('decode'));
  convert.addEventListener('click', () => { try { output.value = mode === 'encode' ? toBase64(input.value) : fromBase64(input.value); status.textContent = output.value ? 'Conversão concluída.' : ''; } catch { output.value = ''; status.textContent = mode === 'decode' ? 'Base64 inválido ou texto não compatível com UTF-8.' : 'Não foi possível converter.'; } });
  document.querySelector('#clear')?.addEventListener('click', () => { input.value = ''; output.value = ''; status.textContent = ''; input.focus(); });
  document.querySelector('#copy')?.addEventListener('click', async () => { if (!output.value) return; await navigator.clipboard.writeText(output.value); status.textContent = 'Resultado copiado.'; });
</script>
</BaseLayout>
