---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { byNewest } from '../../utils/content';
import { CATEGORIES, CONTENT_LEVELS } from '../../config/site';
const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort(byNewest);
---
<BaseLayout title="Artigos" description="Artigos técnicos sobre Platform Engineering, Kubernetes, Cloud, DevOps, SRE, Terraform, GitOps e observabilidade."><div class="container-shell py-14"><Breadcrumb items={[{ label: 'Início', href: '/' }, { label: 'Artigos' }]} /><header class="mt-10 max-w-3xl"><p class="eyebrow">Biblioteca</p><h1 class="mt-3 text-4xl font-black tracking-tight text-slate-950 dark:text-white sm:text-5xl">Artigos técnicos</h1><p class="mt-5 text-lg leading-8 text-slate-600 dark:text-slate-300">Conteúdo prático e revisável para construir, operar e evoluir plataformas.</p></header><div class="surface mt-9 grid gap-4 p-4 sm:grid-cols-3"><label class="text-xs font-semibold uppercase tracking-wide text-slate-500">Buscar<input id="article-query" type="search" class="mt-2 block w-full rounded-lg border border-slate-300 bg-transparent px-3 py-2.5 text-sm normal-case tracking-normal dark:border-slate-700" placeholder="Título ou tag" /></label><label class="text-xs font-semibold uppercase tracking-wide text-slate-500">Categoria<select id="article-category" class="mt-2 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm normal-case tracking-normal dark:border-slate-700 dark:bg-ink-900"><option value="">Todas</option>{CATEGORIES.map((category) => <option value={category}>{category}</option>)}</select></label><label class="text-xs font-semibold uppercase tracking-wide text-slate-500">Nível<select id="article-level" class="mt-2 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm normal-case tracking-normal dark:border-slate-700 dark:bg-ink-900"><option value="">Todos</option>{CONTENT_LEVELS.map((level) => <option value={level}>{level}</option>)}</select></label></div><p id="article-count" class="mt-5 text-sm text-slate-500" aria-live="polite">{articles.length} conteúdos</p><div id="article-grid" class="mt-5 grid gap-5 md:grid-cols-2 lg:grid-cols-3">{articles.map((article) => <div data-article data-category={article.data.category} data-level={article.data.level} data-search={`${article.data.title} ${article.data.description} ${article.data.tags.join(' ')}`}><ArticleCard article={article} /></div>)}</div><p id="article-empty" class="surface mt-5 hidden p-8 text-center text-slate-600 dark:text-slate-300">Nenhum artigo corresponde aos filtros.</p></div><script>
  const query = document.querySelector<HTMLInputElement>('#article-query')!; const category = document.querySelector<HTMLSelectElement>('#article-category')!; const level = document.querySelector<HTMLSelectElement>('#article-level')!; const cards = [...document.querySelectorAll<HTMLElement>('[data-article]')]; const count = document.querySelector('#article-count')!; const empty = document.querySelector('#article-empty')!; const normalize = (value: string) => value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
  const filter = () => { const term = normalize(query.value); let visible = 0; cards.forEach((card) => { const show = (!term || normalize(card.dataset.search ?? '').includes(term)) && (!category.value || card.dataset.category === category.value) && (!level.value || card.dataset.level === level.value); card.classList.toggle('hidden', !show); if (show) visible++; }); count.textContent = `${visible} ${visible === 1 ? 'conteúdo' : 'conteúdos'}`; empty.classList.toggle('hidden', visible > 0); };
  [query, category, level].forEach((field) => field.addEventListener('input', filter));
</script></BaseLayout>
